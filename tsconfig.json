{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "lib": ["es2024", "webworker"],
    "skipLibCheck": true,
    // Bare "hono" imports resolve to the vendored types, as node_modules/hono would.
    "paths": {
      "hono": ["./vendor/hono/index.d.ts"],
      "hono/*": ["./vendor/hono/*.d.ts"]
    }
  },
  "include": ["src", "starter"]
}
